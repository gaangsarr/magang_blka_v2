# ========================================================
# Apache Security & Access Protection — REMATE ITPLN
# ========================================================

Options -Indexes

# 1. Lindungi file sensitif (.env, .git, .json, .lock, .php config, .sql, .sql.gz)
<FilesMatch "^(\.env|\.git|\.gitignore|composer\.(json|lock)|phinx\.php|seed\.php|test_.*\.php|.*\.sql(\.gz)?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Lindungi direktori internal sistem
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses ke direktori terlarang
    RewriteRule ^(migrations|seeds|scripts|scratch|src|vendor|cache|backups)/ - [F,L,NC]

    # BLOCKER-07 & QUALITY-06: Blokir akses ke file test di scripts/ (tidak dihapus, hanya diblok)
    RewriteRule ^scripts/test_ - [F,L,NC]

    # Blokir akses langsung ke file tersembunyi
    RewriteRule (^\.|/\.) - [F,L]
</IfModule>

# 3. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://*.firebaseapp.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; img-src 'self' data: https://*.tile.openstreetmap.org https://unpkg.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://unpkg.com https://cdn.jsdelivr.net https://*.googleapis.com https://*.firebaseio.com https://nominatim.openstreetmap.org https://photon.komoot.io https://wilayah.web.id; frame-src 'self' https://*.firebaseapp.com;"

    # BLOCKER-06: HSTS — Hanya aktif saat Apache + HTTPS production.
    # PHP built-in server (php -S) mengabaikan .htaccess, jadi aman untuk dev lokal.
    # Setelah deploy ke HTTPS, header ini otomatis aktif dan memaksa browser pakai HTTPS selama 1 tahun.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # BLOCKER-06: Permissions Policy — batasi akses browser ke hardware sensitif
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>
