# =============================================
# SISTEM PENDAFTARAN MAGANG ITPLN x PLN PERSERO
# =============================================
# Salin file ini ke .env dan isi nilainya.
# JANGAN commit file .env ke repository!

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=magang_itpln
DB_USER=magang_app
DB_PASS=your_secure_password_here

# User khusus migrasi (hak lebih luas, hanya dipakai pipeline CI/CD)
DB_MIGRATION_USER=magang_migration
DB_MIGRATION_PASS=your_migration_password_here

# --- Firebase / Google ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_FILE=firebase-credentials.json

# --- Session ---
# Kunci enkripsi session, generate dengan: php -r "echo bin2hex(random_bytes(32));"
SESSION_KEY=change_this_to_a_random_64_char_hex_string

# --- App ---
APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true

# --- Reservasi ---
# Durasi reservasi dalam menit
RESERVATION_MINUTES=5

# --- Peminatan ---
# Jumlah maksimum peminatan per pendaftaran
MAX_PEMINATAN=3
