# ==============================================================================
# SISTEM INFORMASI PENDAFTARAN MAGANG ITPLN x PLN PERSERO (v2)
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini ke .env di server/lokal:
#   cp .env.example .env
# JANGAN PERNAH commit file .env hasil copy ke repository!
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (MySQL / MariaDB)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=magang_itpln_v2

# ------------------------------------------------------------------------------
# [H-03] APP DATABASE USER (LEAST PRIVILEGE)
# ------------------------------------------------------------------------------
# ⚠️ ATURAN SECURITY: DI PRODUCTION DILARANG KERAS MENGGUNAKAN 'root'!
# Aplikasi runtime hanya membutuhkan hak DML (SELECT, INSERT, UPDATE, DELETE).
#
# Langkah DevOps membuat user runtime di server MySQL:
#   CREATE USER 'app_magang'@'localhost' IDENTIFIED BY 'password_kuat_disini';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON magang_itpln_v2.* TO 'app_magang'@'localhost';
#   FLUSH PRIVILEGES;
# ------------------------------------------------------------------------------
DB_USER=app_magang
DB_PASS=password_kuat_disini

# ------------------------------------------------------------------------------
# MIGRATION DATABASE USER (Phinx Migration) - OPSIONAL
# ------------------------------------------------------------------------------
# User khusus jika ingin memisahkan user migrasi skema tabel (vendor/bin/phinx migrate).
# JIKA DIKOSONGKAN / TIDAK DIISI: Otomatis memakai DB_USER dan DB_PASS di atas.
# ------------------------------------------------------------------------------
DB_MIGRATION_USER=
DB_MIGRATION_PASS=

# ==============================================================================
# 2. MICROSOFT AZURE ENTRA ID (SSO ITPLN)
# ==============================================================================
# Kredensial SSO dari Azure Portal -> App Registrations
AZURE_TENANT_ID=7b388d18-1900-418c-a5d3-e28d7a9a38e6
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_REDIRECT_URI=https://magang.itpln.ac.id/api/auth/azure/callback.php

# ==============================================================================
# 3. SESSION & TOKEN SECURITY
# ==============================================================================
# [H-05] SESSION_KEY
# Generate key acak 64-karakter hex (32-byte) dengan command:
#   php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
#   atau: openssl rand -hex 32
SESSION_KEY=your_generated_64_character_hex_session_key_here

# ==============================================================================
# 4. APPLICATION ENVIRONMENT
# ==============================================================================
# APP_ENV: 'production' untuk server live, 'local' untuk pengembangan
APP_ENV=production

# APP_URL: URL publik basis aplikasi tanpa trailing slash
APP_URL=https://magang.itpln.ac.id

# APP_DEBUG: 'false' untuk production (mencegah leak informasi & error trace)
APP_DEBUG=false

# ==============================================================================
# 5. BUSINESS RULES & PARAMETERS
# ==============================================================================
RESERVATION_MINUTES=5
MAX_PEMINATAN=3
# ==============================================================================
# 6. SMTP EMAIL NOTIFICATION (GMAIL / OFFICE 365)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="INTERN ITPLN - Sistem Magang"

