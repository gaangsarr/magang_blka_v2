{
    "name": "itpln/magang-pln",
    "description": "Sistem Pendaftaran Magang ITPLN x PT PLN Persero",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "robmorgan/phinx": "^0.16",
        "vlucas/phpdotenv": "^5.6",
        "phpoffice/phpspreadsheet": "^3.0",
        "phpoffice/phpword": "^1.4",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "vendor/bin/phinx migrate",
        "rollback": "vendor/bin/phinx rollback",
        "seed": "vendor/bin/phinx seed:run",
        "test": "vendor/bin/phpunit"
    }
}
